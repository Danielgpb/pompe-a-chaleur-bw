---
import Layout from '../layouts/Layout.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
---

<Layout
  title="Devis gratuit pompe à chaleur et chauffage | PAC BW"
  description="Demandez un devis gratuit pour votre pompe à chaleur, climatisation ou chauffage en Brabant Wallon. Réponse sous 24h."
  canonical="/devis/"
>

<Breadcrumb items={[{ label: 'Devis gratuit' }]} />

<div class="max-w-2xl mx-auto px-4 sm:px-6 py-10">

  <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--color-vert-fonce)] mb-4">
    Demandez votre devis gratuit
  </h1>
  <p class="text-lg text-[var(--color-texte-light)] mb-8">
    Réponse sous 24h. Sans engagement. On vous rappelle pour fixer un rendez-vous sur place si nécessaire.
  </p>

  <h2 class="text-2xl font-extrabold text-[var(--color-vert-fonce)] mb-4">Comment ça se passe ?</h2>
  <ol class="list-decimal pl-6 space-y-2 text-[var(--color-texte-light)] mb-8">
    <li><strong>Vous remplissez le formulaire ci-dessous</strong> — ça prend 2 minutes, montre en main.</li>
    <li><strong>On vous rappelle dans les 24h</strong> pour discuter de votre projet et répondre à vos premières questions.</li>
    <li><strong>On passe chez vous</strong> pour un état des lieux gratuit, on regarde votre installation actuelle, et on vous envoie un devis détaillé dans la foulée.</li>
  </ol>

  <h2 class="text-2xl font-extrabold text-[var(--color-vert-fonce)] mb-4">Ce que vous trouverez dans notre devis</h2>
  <p class="text-[var(--color-texte-light)] mb-8">
    Chaque poste est détaillé ligne par ligne, en français normal — pas de codes obscurs ni d'abréviations que seul un technicien comprend. Les prix sont affichés TTC, les <a href="https://energie.wallonie.be" target="_blank" rel="noopener noreferrer" class="text-[var(--color-vert)] font-semibold underline underline-offset-2">primes Wallonie</a> sont déduites séparément pour que vous voyiez ce que vous payez vraiment, et on indique le planning des travaux avec les dates prévues. Bref, vous savez exactement où va votre argent avant de signer quoi que ce soit.
  </p>

  <form action="#" method="POST" class="space-y-5">

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="nom" class="block text-sm font-semibold text-[var(--color-vert-fonce)] mb-1">Nom *</label>
        <input type="text" id="nom" name="nom" required
          class="w-full border border-[var(--color-bordure)] rounded-lg px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-[var(--color-vert)] focus:border-transparent" />
      </div>
      <div>
        <label for="prenom" class="block text-sm font-semibold text-[var(--color-vert-fonce)] mb-1">Prénom *</label>
        <input type="text" id="prenom" name="prenom" required
          class="w-full border border-[var(--color-bordure)] rounded-lg px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-[var(--color-vert)] focus:border-transparent" />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="email" class="block text-sm font-semibold text-[var(--color-vert-fonce)] mb-1">Email *</label>
        <input type="email" id="email" name="email" required
          class="w-full border border-[var(--color-bordure)] rounded-lg px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-[var(--color-vert)] focus:border-transparent" />
      </div>
      <div>
        <label for="tel" class="block text-sm font-semibold text-[var(--color-vert-fonce)] mb-1">Téléphone *</label>
        <input type="tel" id="tel" name="tel" required
          class="w-full border border-[var(--color-bordure)] rounded-lg px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-[var(--color-vert)] focus:border-transparent" />
      </div>
    </div>

    <div>
      <label for="commune" class="block text-sm font-semibold text-[var(--color-vert-fonce)] mb-1">Commune *</label>
      <select id="commune" name="commune" required
        class="w-full border border-[var(--color-bordure)] rounded-lg px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-[var(--color-vert)] focus:border-transparent bg-white">
        <option value="">Sélectionnez votre commune</option>
        <option>Wavre (1300)</option>
        <option>Waterloo (1410)</option>
        <option>Lasne (1380)</option>
        <option>Braine-l'Alleud (1420)</option>
        <option>Rixensart (1330)</option>
        <option>La Hulpe (1310)</option>
        <option>Ottignies-Louvain-la-Neuve (1340)</option>
        <option>Grez-Doiceau (1390)</option>
        <option>Chaumont-Gistoux (1325)</option>
        <option>Court-Saint-Étienne (1490)</option>
        <option>Autre commune</option>
      </select>
    </div>

    <div>
      <label for="service" class="block text-sm font-semibold text-[var(--color-vert-fonce)] mb-1">Service souhaité *</label>
      <select id="service" name="service" required
        class="w-full border border-[var(--color-bordure)] rounded-lg px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-[var(--color-vert)] focus:border-transparent bg-white">
        <option value="">Quel service vous intéresse ?</option>
        <option>Pompe à chaleur (installation)</option>
        <option>Pompe à chaleur (remplacement chaudière mazout)</option>
        <option>Pompe à chaleur (entretien / dépannage)</option>
        <option>Climatisation (installation)</option>
        <option>Climatisation (entretien / dépannage)</option>
        <option>Chauffage (chaudière gaz)</option>
        <option>Chauffage (chauffage sol)</option>
        <option>Chauffage (entretien / dépannage)</option>
        <option>Ventilation (VMC)</option>
        <option>Panneaux solaires</option>
        <option>Boiler thermodynamique</option>
        <option>Borne de recharge</option>
        <option>Sanitaire / plomberie</option>
        <option>Électricité / domotique</option>
        <option>Autre</option>
      </select>
    </div>

    <div>
      <label for="message" class="block text-sm font-semibold text-[var(--color-vert-fonce)] mb-1">Décrivez votre projet</label>
      <textarea id="message" name="message" rows="5" placeholder="Type de maison, année de construction, système actuel, ce que vous souhaitez..."
        class="w-full border border-[var(--color-bordure)] rounded-lg px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-[var(--color-vert)] focus:border-transparent resize-y"></textarea>
    </div>

    <button type="submit"
      class="w-full bg-[var(--color-orange)] text-white font-bold text-lg py-4 rounded-xl shadow-lg shadow-orange-200 hover:shadow-xl hover:-translate-y-0.5 transition-all">
      Envoyer ma demande de devis
    </button>

    <p class="text-xs text-[var(--color-texte-light)] text-center">
      Gratuit et sans engagement. Vos données ne sont utilisées que pour vous répondre.
    </p>
  </form>

</div>

<div class="h-20 lg:hidden"></div>

</Layout>
