---
import Layout from '../layouts/Layout.astro'
import Icons from '../components/Icons.astro'
import ReviewsCarousel from '../components/ReviewsCarousel.astro'
import VideoPresentation from '../components/VideoPresentation.astro'

// Hiérarchie : 2 services phares (PAC + Clim), 6 services secondaires
const servicesPrimary = [
  {
    num: '01',
    icon: 'flame',
    title: 'Pompe à chaleur',
    kicker: 'Notre métier de cœur',
    desc: 'Air-eau, air-air, hybride. On remplace votre chaudière mazout avant la deadline 2031. Primes Wallonie incluses dans le devis.',
    href: '/pompe-a-chaleur/',
  },
  {
    num: '02',
    icon: 'snowflake',
    title: 'Climatisation',
    kicker: 'Frigoriste certifié',
    desc: 'Mono-split, multi-split, réversible, gainable. Daikin, LG, Gree. On dimensionne avant de vendre — pas l\'inverse.',
    href: '/climatisation/',
  },
]

const servicesSecondary = [
  { num: '03', title: 'Chauffage', desc: 'Chaudière gaz condensation, sol, radiateurs. Entretien 3 ans Wallonie.', href: '/chauffage/' },
  { num: '04', title: 'Ventilation', desc: 'VMC simple et double flux. Pour votre PEB et contre les moisissures.', href: '/ventilation/' },
  { num: '05', title: 'Panneaux solaires', desc: 'Installation, batterie, onduleur. On calcule votre autoconsommation d\'abord.', href: '/panneaux-solaires/' },
  { num: '06', title: 'Sanitaire', desc: 'Salle de bain, adoucisseur, eau de pluie. Dépannage plomberie quand ça presse.', href: '/sanitaire/' },
  { num: '07', title: 'Électricité & domotique', desc: 'Niko, Domintell. Conformité RGIE, rénovation, tableau.', href: '/electricite/' },
  { num: '08', title: 'Bornes de recharge', desc: 'Wallbox, charge intelligente avec PV. Passage triphasé si besoin.', href: '/bornes-de-recharge/' },
]

const zones = [
  { name: 'Wavre', cp: '1300', href: '/wavre/' },
  { name: 'Waterloo', cp: '1410', href: '/waterloo/' },
  { name: 'Lasne', cp: '1380', href: '/lasne/' },
  { name: "Braine-l'Alleud", cp: '1420', href: '/braine-l-alleud/' },
  { name: 'Rixensart', cp: '1330', href: '/rixensart/' },
  { name: 'La Hulpe', cp: '1310', href: '/la-hulpe/' },
  { name: 'Ottignies-LLN', cp: '1340', href: '/ottignies-louvain-la-neuve/' },
  { name: 'Grez-Doiceau', cp: '1390', href: '/grez-doiceau/' },
  { name: 'Chaumont-Gistoux', cp: '1325', href: '/chaumont-gistoux/' },
  { name: 'Court-Saint-Étienne', cp: '1490', href: '/court-saint-etienne/' },
]

const marques = ['Daikin', 'LG', 'Gree', 'Vaillant', 'Bemco', 'Bosch', 'Remeha', 'Atlantic', 'Ariston', 'Niko']

// FAQ — source unique pour affichage ET schema FAQPage
const faqs = [
  {
    q: "Combien ça coûte une pompe à chaleur installée ?",
    a: `Ça dépend du type. Une <a href="/pompe-a-chaleur/air-air/" class="link-editorial">PAC air-air</a> (qui fait aussi clim), comptez entre 4 000 et 6 000 euros. Une <a href="/pompe-a-chaleur/air-eau/" class="link-editorial">air-eau</a> pour chauffer toute la maison, c'est plutôt 8 000 à 15 000 euros. Ça inclut le matériel, la pose et la mise en service. Les <a href="/pompe-a-chaleur/primes-wallonie/" class="link-editorial">primes Wallonie</a> peuvent réduire la facture de 600 à 3 600 euros. On met tout ça dans le <a href="/devis/" class="link-editorial">devis</a> pour que vous voyiez ce que vous payez vraiment.`,
    open: true,
  },
  {
    q: "Ma chaudière mazout fonctionne encore. Je dois quand même la remplacer ?",
    a: `Pas tout de suite, non. Tant qu'elle marche, vous pouvez la garder. Mais le jour où elle lâche, après 2031 vous ne pourrez plus la remplacer par une chaudière mazout. Et si c'est en plein hiver, les délais d'installation d'une PAC sont plus longs qu'un simple échange de chaudière. On a écrit un <a href="/pompe-a-chaleur/remplacement-chaudiere/" class="link-editorial">guide complet sur le remplacement de chaudière mazout</a> si vous voulez en savoir plus. Notre conseil : anticipez. Venez en discuter quand vous avez le temps, pas quand vous grelottez.`,
  },
  {
    q: "C'est vrai que les pompes à chaleur font du bruit ?",
    a: `Les anciens modèles, oui. Les nouveaux, beaucoup moins. Une Daikin Altherma récente tourne à 35 dB — c'est le bruit d'une bibliothèque. Par contre, l'emplacement de l'unité extérieure, c'est important. Il y a une réglementation en Wallonie : 45 dB maximum en journée, 40 dB la nuit à la limite de propriété. On regarde toujours avec vous où la placer pour éviter les soucis avec les voisins. Plus de détails sur notre page <a href="/pompe-a-chaleur/" class="link-editorial">pompe à chaleur</a>.`,
  },
  {
    q: "Vous faites aussi le dépannage ?",
    a: `Oui. <a href="/pompe-a-chaleur/depannage/" class="link-editorial">Dépannage PAC</a>, <a href="/climatisation/depannage/" class="link-editorial">dépannage clim</a>, <a href="/chauffage/depannage/" class="link-editorial">dépannage chaudière</a>. On dépanne les installations qu'on a posées, mais aussi celles des autres. Honnêtement, on préfère les contrats d'<a href="/pompe-a-chaleur/entretien/" class="link-editorial">entretien</a> — ça évite les pannes — mais quand ça tombe en panne un samedi soir en janvier, on est là.`,
  },
  {
    q: "Les primes en Wallonie, ça marche comment ?",
    a: `C'est le bazar, soyons honnêtes. Il y a les <a href="https://energie.wallonie.be" target="_blank" rel="noopener" class="link-editorial">Primes Habitation</a>, le Rénopack avec prêt à taux zéro, la TVA à 6 % si votre maison a plus de 10 ans... Les montants dépendent de vos revenus et du type de travaux. Pour une PAC, ça va de 600 à 3 600 euros. Il faut un audit logement avant. On a fait une <a href="/pompe-a-chaleur/primes-wallonie/" class="link-editorial">page complète sur les primes Wallonie 2026</a> pour y voir clair. Et on vous aide à remplir les formulaires — c'est compris dans notre service, on ne facture pas ça en plus.`,
  },
]

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a.replace(/<[^>]*>/g, '').trim(),
    },
  })),
}
---

<Layout
  title="Pompe à chaleur Brabant Wallon | Chauffage & Clim | PAC BW"
  description="Installateur agréé pompe à chaleur, climatisation et chauffage en Brabant Wallon. Wavre, Waterloo, Lasne. Frigoriste certifié. Devis gratuit."
  canonical="/"
  geoLat={50.71640}
  geoLng={4.60130}
  geoPlacename="Wavre"
  preloadHero="/images/hero/hero-accueil.webp"
>

  <!-- ===== HERO — layout éditorial asymétrique ===== -->
  <section class="relative overflow-hidden border-b border-[var(--color-bordure)]">
    <div class="max-w-[88rem] mx-auto px-4 sm:px-8 pt-10 sm:pt-16 pb-6">
      <!-- Meta line éditoriale -->
      <div class="flex items-center gap-4 text-xs font-medium text-[var(--color-texte-light)] mb-8 sm:mb-12">
        <span class="section-number">N° 001 — Brabant Wallon</span>
        <span class="h-px flex-1 bg-[var(--color-bordure)]"></span>
        <span class="hidden sm:inline uppercase tracking-wider">Installateur agréé · Frigoriste certifié</span>
      </div>

      <div class="grid grid-cols-12 gap-y-8 gap-x-4 sm:gap-x-8 items-end">
        <!-- Titre XL — prend toute la largeur -->
        <h1 class="col-span-12 font-display font-semibold text-[var(--color-vert-fonce)]" style="font-size: var(--text-hero);">
          <span class="block">Pompe à chaleur, chauffage</span>
          <span class="block text-[var(--color-vert)]" style="font-variation-settings: 'wdth' 75; font-weight: 500;">et climatisation en Brabant Wallon.</span>
          <span class="block">On&nbsp;passe&nbsp;demain.</span>
        </h1>

        <!-- Sous-titre à gauche -->
        <div class="col-span-12 lg:col-span-5 lg:col-start-1 mt-2">
          <p class="text-[var(--color-texte)] leading-relaxed" style="font-size: 1.1875rem;">
            <strong>Pompe à chaleur BW</strong> — installateur agréé de chauffage, pompes à chaleur et climatisation en Brabant Wallon. Wavre, Waterloo, Lasne et 10 communes. On répond au téléphone. On donne un vrai devis. Pas de bla-bla.
          </p>
        </div>

        <!-- CTA bloc à droite — décalé -->
        <div class="col-span-12 lg:col-span-5 lg:col-start-8 flex flex-col sm:flex-row lg:flex-col gap-3">
          <a
            href="/devis/"
            class="group inline-flex items-center justify-between gap-4 bg-[var(--color-vert-fonce)] text-[var(--color-fond)] font-semibold px-7 py-5 hover:bg-[var(--color-vert)] transition-colors"
          >
            <span class="flex flex-col leading-tight">
              <span class="text-xs uppercase tracking-widest opacity-60 mb-1">Étape 1</span>
              <span class="text-lg">Demander un devis gratuit</span>
            </span>
            <svg class="w-6 h-6 shrink-0 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a
            href="tel:+3228861457"
            class="group inline-flex items-center justify-between gap-4 border border-[var(--color-vert-fonce)] text-[var(--color-vert-fonce)] font-semibold px-7 py-5 hover:bg-[var(--color-vert-fonce)] hover:text-[var(--color-fond)] transition-colors"
          >
            <span class="flex flex-col leading-tight">
              <span class="text-xs uppercase tracking-widest opacity-60 mb-1">Ou directement</span>
              <span class="text-lg tabular-nums">02 / 886 14 57</span>
            </span>
            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Image hero — full-bleed sous la typo -->
    <div class="relative">
      <div class="max-w-[88rem] mx-auto px-4 sm:px-8">
        <div class="relative overflow-hidden aspect-[21/9] sm:aspect-[16/7]">
          <img
            src="/images/hero/hero-accueil.webp"
            alt="Installation pompe à chaleur par l'équipe Pompe à chaleur BW en Brabant Wallon"
            width="1800" height="770"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="w-full h-full object-cover"
            onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
          />
          <div class="bg-[var(--color-vert-fonce)] text-[var(--color-fond)] p-12 flex-col justify-between absolute inset-0 hidden">
            <p class="section-number" style="color: var(--color-orange);">Nos marques partenaires</p>
            <p class="font-display text-3xl sm:text-5xl leading-none" style="font-variation-settings: 'wdth' 110;">Daikin · LG · Vaillant · Bosch · Gree</p>
          </div>

          <!-- Bandeau info sur l'image -->
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[var(--color-vert-fonce)]/85 via-[var(--color-vert-fonce)]/40 to-transparent p-6 sm:p-10">
            <div class="flex flex-wrap items-end justify-between gap-6 text-[var(--color-fond)]">
              <div>
                <p class="text-xs uppercase tracking-widest opacity-70 mb-1">Installation · Dépannage · Entretien</p>
                <p class="font-display text-xl sm:text-3xl" style="font-variation-settings: 'wdth' 90; letter-spacing: -0.02em;">
                  Daikin · LG · Gree · Vaillant · Bosch
                </p>
              </div>
              <div class="flex items-center gap-6 text-sm">
                <div><p class="text-2xl font-display font-semibold tabular-nums">10</p><p class="text-xs opacity-70">communes</p></div>
                <div class="h-10 w-px bg-[var(--color-fond)]/30"></div>
                <div><p class="text-2xl font-display font-semibold tabular-nums">5,0<span class="text-base">/5</span></p><p class="text-xs opacity-70">Google Avis</p></div>
                <div class="h-10 w-px bg-[var(--color-fond)]/30 hidden sm:block"></div>
                <div class="hidden sm:block"><p class="text-2xl font-display font-semibold tabular-nums">24<span class="text-base">h</span></p><p class="text-xs opacity-70">réponse devis</p></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== AVIS CLIENTS ===== -->
  <ReviewsCarousel />

  <!-- ===== TRUST BAR CARROUSEL ===== -->
  <section class="bg-[var(--color-blanc)] border-y border-[var(--color-bordure)] py-6 overflow-hidden">
    <div class="max-w-[88rem] mx-auto px-4 sm:px-8 mb-4 flex items-center gap-4">
      <span class="section-number">§ Marques partenaires</span>
      <span class="h-px flex-1 bg-[var(--color-bordure)]"></span>
      <span class="hidden sm:inline text-xs text-[var(--color-texte-light)] uppercase tracking-wider">Pas de marque maison, pas de stock à écouler</span>
    </div>
    <div class="marquee-wrapper">
      <div class="marquee-track">
        {[...Array(2)].map(() => (
          <div class="marquee-logos">
            {[
              { name: 'Daikin', file: 'daikin-logo' },
              { name: 'LG', file: 'lg-logo' },
              { name: 'Gree', file: 'gree-logo' },
              { name: 'Vaillant', file: 'vaillant-logo' },
              { name: 'Bemco', file: 'bemco-logo' },
              { name: 'Bosch', file: 'bosch-logo' },
              { name: 'Remeha', file: 'remeha-logo' },
              { name: 'Atlantic', file: 'atlantic-logo' },
              { name: 'Ariston', file: 'ariston-logo' },
              { name: 'Niko', file: 'niko-logo' },
            ].map(m => (
              <img
                src={`/images/marques/${m.file}.webp`}
                alt={`Logo ${m.name} — partenaire Pompe à chaleur BW`}
                width="120"
                height="45"
                loading="lazy"
                decoding="async"
                class="h-9 sm:h-12 w-auto object-contain mx-10 opacity-70 hover:opacity-100 transition-opacity"
              />
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    .marquee-wrapper {
      overflow: hidden;
      width: 100%;
    }
    .marquee-track {
      display: flex;
      width: max-content;
      animation: marquee 25s linear infinite;
    }
    .marquee-logos {
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }
    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .marquee-wrapper:hover .marquee-track {
      animation-play-state: paused;
    }
  </style>

  <!-- ===== INTRO CONTENU — Goal Completion + SEO ===== -->
  <section class="py-20 sm:py-24 px-4 sm:px-8">
    <div class="max-w-[88rem] mx-auto grid grid-cols-12 gap-x-8 gap-y-6">
      <div class="col-span-12 lg:col-span-4">
        <p class="section-number mb-4">§ 02 — Introduction</p>
        <h2 class="font-display font-semibold text-[var(--color-vert-fonce)]" style="font-size: var(--text-3xl); line-height: 1.02; letter-spacing: -0.02em;">
          Installation pompe à chaleur et climatisation en Brabant Wallon.
        </h2>
      </div>
      <div class="col-span-12 lg:col-span-7 lg:col-start-6 prose-editorial text-[var(--color-texte)]">
        <p>
          Bon, on va pas se mentir. Trouver un installateur de pompe à chaleur qui répond au téléphone et qui donne un devis sans vous faire attendre trois semaines, c'est pas toujours simple dans le coin.
        </p>
        <p>
          On est une équipe d'installateurs basée en Brabant Wallon. On fait les <a href="/pompe-a-chaleur/" class="link-editorial">pompes à chaleur</a> — air-eau, air-air, hybrides — la <a href="/climatisation/" class="link-editorial">climatisation</a>, le <a href="/chauffage/" class="link-editorial">chauffage</a>, la <a href="/ventilation/" class="link-editorial">ventilation</a>, les <a href="/panneaux-solaires/" class="link-editorial">panneaux solaires</a> et le reste. On travaille avec <a href="https://www.daikin.be" target="_blank" rel="noopener" class="link-editorial">Daikin</a>, LG, Vaillant, Bosch, Gree. Pas de marque maison, pas de stock à écouler. On vous conseille ce qui va le mieux pour votre maison, point.
        </p>
        <p>
          L'hiver dernier, la moitié de nos appels venaient de gens à <a href="/wavre/" class="link-editorial">Wavre</a> et <a href="/waterloo/" class="link-editorial">Waterloo</a> dont la chaudière mazout avait lâché. Avec l'interdiction qui tombe en 2026 pour les constructions neuves, beaucoup de propriétaires se posent la question : on répare encore une fois, ou on passe à la <a href="/pompe-a-chaleur/remplacement-chaudiere/" class="link-editorial">pompe à chaleur</a> ? Si c'est votre cas, on peut venir faire un état des lieux chez vous. Gratuit, sans engagement. On vous dit ce qui est possible, combien ça coûte, et quelles <a href="/pompe-a-chaleur/primes-wallonie/" class="link-editorial">primes</a> vous pouvez avoir.
        </p>
        <p>
          On fait aussi le <a href="/sanitaire/" class="link-editorial">sanitaire</a>, l'<a href="/electricite/" class="link-editorial">électricité</a>, la <a href="/domotique/" class="link-editorial">domotique</a>, les <a href="/bornes-de-recharge/" class="link-editorial">bornes de recharge</a> et les <a href="/boiler-thermodynamique/" class="link-editorial">boilers thermodynamiques</a>. Et pour ceux qui ont déjà une PAC ou une clim, on fait aussi l'entretien et le dépannage. Même le week-end quand il fait 35 degrés et que votre split ne souffle plus que de l'air tiède.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== SERVICES — hiérarchie éditoriale ===== -->
  <section class="py-20 sm:py-28 px-4 sm:px-8 bg-[var(--color-blanc)]">
    <div class="max-w-[88rem] mx-auto">

      <!-- En-tête éditorial -->
      <div class="flex items-end justify-between gap-6 mb-14 pb-8 border-b border-[var(--color-bordure)]">
        <div>
          <p class="section-number mb-3">§ Services</p>
          <h2 class="font-display font-semibold text-[var(--color-vert-fonce)] max-w-3xl" style="font-size: var(--text-4xl); line-height: 1.02;">
            Ce qu'on fait, <span class="text-[var(--color-vert)]" style="font-variation-settings: 'wdth' 75; font-weight: 500;">concrètement</span>.
          </h2>
        </div>
        <p class="hidden lg:block text-sm text-[var(--color-texte-light)] max-w-xs text-right leading-relaxed">
          Huit métiers sous un toit. Deux qu'on fait mieux que la moyenne : la pompe à chaleur et la clim.
        </p>
      </div>

      <!-- Services phares — 2 blocs éditoriaux larges -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-px bg-[var(--color-bordure)] mb-px">
        {servicesPrimary.map(s => (
          <a
            href={s.href}
            class="group relative block bg-[var(--color-blanc)] p-8 sm:p-12 hover:bg-[var(--color-vert-clair)] transition-colors"
          >
            <div class="flex items-start justify-between mb-8">
              <span class="section-number">{s.num} · {s.kicker}</span>
              <div class="text-[var(--color-vert)] opacity-80 group-hover:opacity-100 transition-opacity"><Icons name={s.icon} class="w-10 h-10" /></div>
            </div>
            <h3 class="font-display text-[var(--color-vert-fonce)] mb-5" style="font-size: var(--text-4xl); line-height: 0.98; letter-spacing: -0.025em;">
              {s.title}
            </h3>
            <p class="text-[var(--color-texte-light)] leading-relaxed max-w-md mb-8" style="font-size: 1.0625rem;">
              {s.desc}
            </p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-vert)]">
              Voir en détail
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>

      <!-- Services secondaires — liste compacte 3 colonnes -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-[var(--color-bordure)]">
        {servicesSecondary.map(s => (
          <a
            href={s.href}
            class="group block bg-[var(--color-blanc)] p-6 hover:bg-[var(--color-fond)] transition-colors"
          >
            <div class="flex items-baseline gap-3 mb-2">
              <span class="text-xs font-display font-medium text-[var(--color-vert)] tabular-nums" style="font-variation-settings: 'wdth' 75;">{s.num}</span>
              <h3 class="font-display text-[var(--color-vert-fonce)] text-xl font-semibold" style="letter-spacing: -0.015em;">
                {s.title}
              </h3>
            </div>
            <p class="text-sm text-[var(--color-texte-light)] leading-relaxed pl-9">{s.desc}</p>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- ===== VIDÉO PRÉSENTATION — façade YouTube (perf) + schema ===== -->
  <VideoPresentation number="§ 03 — En vidéo" schema={true} />

  <!-- ===== POURQUOI NOUS (contenu authentique) ===== -->
  <section class="py-20 sm:py-24 px-4 sm:px-8 bg-[var(--color-surface)]">
    <div class="max-w-[88rem] mx-auto grid grid-cols-12 gap-x-8 gap-y-6">
      <div class="col-span-12 lg:col-span-4">
        <p class="section-number mb-4">§ 04 — Méthode</p>
        <h2 class="font-display font-semibold text-[var(--color-vert-fonce)]" style="font-size: var(--text-3xl); line-height: 1.02; letter-spacing: -0.02em;">
          Pourquoi les gens nous appellent.
        </h2>
      </div>
      <div class="col-span-12 lg:col-span-7 lg:col-start-6 prose-editorial text-[var(--color-texte)]">
        <p>
          On va pas vous sortir les classiques du genre « 20 ans d'expérience » et « satisfaction garantie ». Vous les avez lus sur tous les sites de chauffagistes du Brabant Wallon.
        </p>
        <p>
          Ce qu'on entend le plus souvent quand les gens nous appellent, c'est : <strong>« J'ai appelé trois boîtes, personne ne rappelle. »</strong> Ou alors : <strong>« On m'a fait un devis mais je comprends rien à ce qu'il y a dedans. »</strong>
        </p>
        <p>
          Nous, on fonctionne simplement. Vous appelez. On répond ou on rappelle dans la journée. On passe chez vous, on regarde votre installation, on discute de ce que vous voulez. Ensuite vous recevez un devis détaillé où chaque ligne est expliquée. Le prix que vous voyez, c'est le prix que vous payez. Pas de surprises.
        </p>
        <p>
          Et si vous avez droit à des primes — et en Wallonie, la plupart des gens y ont droit — on vous dit exactement combien et on vous aide avec les papiers. Parce que remplir un dossier de prime Wallonie un dimanche soir, c'est pas franchement la meilleure soirée.
        </p>
      </div>
    </div>
  </section>

