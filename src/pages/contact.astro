---
import Layout from '../layouts/Layout.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import LeadForm from '../components/LeadForm.astro'
---

<Layout
  title="Contact | Pompe à chaleur BW"
  description="Contactez Pompe à chaleur BW. Téléphone, formulaire, zones d'intervention en Brabant Wallon. Réponse sous 24h."
  canonical="/contact/"
>

<Breadcrumb items={[{ label: 'Contact' }]} />

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">

  <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--color-vert-fonce)] mb-4">
    Contactez-nous
  </h1>
  <p class="text-lg text-[var(--color-texte-light)] mb-10">
    Pompe à chaleur BW — installateur en Brabant Wallon. Appelez ou écrivez, on répond dans la journée.
  </p>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">

    <!-- Colonne gauche : infos -->
    <div class="space-y-8">

      <!-- Téléphone -->
      <div class="bg-white border border-[var(--color-bordure)] rounded-xl p-6">
        <h2 class="text-lg font-bold text-[var(--color-vert-fonce)] mb-3">Téléphone</h2>
        <a href="tel:+3228861457" class="text-2xl font-extrabold text-[var(--color-vert)] hover:text-[var(--color-vert-fonce)] transition-colors">
          02 / 886 14 57
        </a>
        <p class="text-sm text-[var(--color-texte-light)] mt-2">Lundi - Dimanche : 8h - 20h</p>
      </div>

      <!-- Adresse -->
      <div class="bg-white border border-[var(--color-bordure)] rounded-xl p-6">
        <h2 class="text-lg font-bold text-[var(--color-vert-fonce)] mb-3">Adresse</h2>
        <p class="text-[var(--color-texte-light)] mb-4">
          Pompe à chaleur BW<br>
          Rue de Nivelles 77<br>
          1300 Wavre<br>
          Belgique
        </p>
        <div class="rounded-lg overflow-hidden">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1267.1!2d4.6064332!3d50.7143234!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c17dc22e29281b%3A0x4029a47e136cfb7a!2sPompe%20%C3%A0%20chaleur%20BW!5e0!3m2!1sfr!2sbe!4v1712400000000"
            width="100%"
            height="250"
            style="border:0"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Pompe à chaleur BW — Rue de Nivelles 77, 1300 Wavre"
          ></iframe>
        </div>
      </div>

      <!-- Zones -->
      <div class="bg-white border border-[var(--color-bordure)] rounded-xl p-6">
        <h2 class="text-lg font-bold text-[var(--color-vert-fonce)] mb-3">Zones d'intervention</h2>
        <p class="text-sm text-[var(--color-texte-light)] mb-3">On intervient dans 12 communes du Brabant Wallon :</p>
        <div class="grid grid-cols-2 gap-2">
          {[
            { name: 'Wavre', href: '/wavre/' },
            { name: 'Waterloo', href: '/waterloo/' },
            { name: 'Lasne', href: '/lasne/' },
            { name: "Braine-l'Alleud", href: '/braine-l-alleud/' },
            { name: 'Rixensart', href: '/rixensart/' },
            { name: 'La Hulpe', href: '/la-hulpe/' },
            { name: 'Ottignies-LLN', href: '/ottignies-louvain-la-neuve/' },
            { name: 'Grez-Doiceau', href: '/grez-doiceau/' },
            { name: 'Chaumont-Gistoux', href: '/chaumont-gistoux/' },
            { name: 'Court-Saint-Étienne', href: '/court-saint-etienne/' },
            { name: 'Ittre', href: '/ittre/' },
            { name: 'Rhode-Saint-Genèse', href: '/rhode-saint-genese/' },
          ].map(z => (
            <a href={z.href} class="text-sm text-[var(--color-vert)] font-medium hover:underline">{z.name}</a>
          ))}
        </div>
      </div>

      <!-- Services -->
      <div class="bg-white border border-[var(--color-bordure)] rounded-xl p-6">
        <h2 class="text-lg font-bold text-[var(--color-vert-fonce)] mb-3">Nos services</h2>
        <ul class="space-y-1">
          {[
            { label: 'Pompe à chaleur', href: '/pompe-a-chaleur/' },
            { label: 'Climatisation', href: '/climatisation/' },
            { label: 'Chauffage', href: '/chauffage/' },
            { label: 'Ventilation', href: '/ventilation/' },
            { label: 'Panneaux solaires', href: '/panneaux-solaires/' },
            { label: 'Sanitaire', href: '/sanitaire/' },
            { label: 'Électricité & domotique', href: '/electricite/' },
            { label: 'Bornes de recharge', href: '/bornes-de-recharge/' },
            { label: 'Boiler thermodynamique', href: '/boiler-thermodynamique/' },
          ].map(s => (
            <li><a href={s.href} class="text-sm text-[var(--color-vert)] font-medium hover:underline">{s.label}</a></li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Colonne droite : formulaire -->
    <div>
      <div class="bg-white border border-[var(--color-bordure)] rounded-xl p-6 sticky top-20">
        <h2 class="text-lg font-bold text-[var(--color-vert-fonce)] mb-4">Envoyez-nous un message</h2>
        <LeadForm compact={true} />
      </div>
    </div>

  </div>
</div>

<div class="h-20 lg:hidden"></div>

</Layout>
