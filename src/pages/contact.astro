---
import Layout from '../layouts/Layout.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
---

<Layout
  title="Contact | Pompe à chaleur BW"
  description="Contactez Pompe à chaleur BW. Téléphone, formulaire, zones d'intervention en Brabant Wallon. Réponse sous 24h."
  canonical="/contact/"
>

<Breadcrumb items={[{ label: 'Contact' }]} />

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">

  <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--color-vert-fonce)] mb-4">
    Contactez-nous
  </h1>
  <p class="text-lg text-[var(--color-texte-light)] mb-10">
    Pompe à chaleur BW — installateur en Brabant Wallon. Appelez ou écrivez, on répond dans la journée.
  </p>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">

    <!-- Colonne gauche : infos -->
    <div class="space-y-8">

      <!-- Téléphone -->
      <div class="bg-white border border-[var(--color-bordure)] rounded-xl p-6">
        <h2 class="text-lg font-bold text-[var(--color-vert-fonce)] mb-3">Téléphone</h2>
        <a href="tel:+3228861457" class="text-2xl font-extrabold text-[var(--color-vert)] hover:text-[var(--color-vert-fonce)] transition-colors">
          02 / 886 14 57
        </a>
        <p class="text-sm text-[var(--color-texte-light)] mt-2">Lundi - Vendredi : 8h - 18h<br>Samedi : 9h - 13h</p>
        <p class="text-sm text-[var(--color-texte-light)] mt-1">Dépannage urgent ? On répond aussi en dehors des heures.</p>
      </div>

      <!-- Adresse -->
      <div class="bg-white border border-[var(--color-bordure)] rounded-xl p-6">
        <h2 class="text-lg font-bold text-[var(--color-vert-fonce)] mb-3">Adresse</h2>
        <p class="text-[var(--color-texte-light)]">
          Pompe à chaleur BW<br>
          <!-- À compléter avec l'adresse exacte -->
          Brabant Wallon<br>
          Belgique
        </p>
      </div>

      <!-- Zones -->
      <div class="bg-white border border-[var(--color-bordure)] rounded-xl p-6">
        <h2 class="text-lg font-bold text-[var(--color-vert-fonce)] mb-3">Zones d'intervention</h2>
        <p class="text-sm text-[var(--color-texte-light)] mb-3">On intervient dans 10 communes du Brabant Wallon :</p>
        <div class="grid grid-cols-2 gap-2">
          {[
            { name: 'Wavre', href: '/zone/wavre/' },
            { name: 'Waterloo', href: '/zone/waterloo/' },
            { name: 'Lasne', href: '/zone/lasne/' },
            { name: "Braine-l'Alleud", href: '/zone/braine-l-alleud/' },
            { name: 'Rixensart', href: '/zone/rixensart/' },
            { name: 'La Hulpe', href: '/zone/la-hulpe/' },
            { name: 'Ottignies-LLN', href: '/zone/ottignies-louvain-la-neuve/' },
            { name: 'Grez-Doiceau', href: '/zone/grez-doiceau/' },
            { name: 'Chaumont-Gistoux', href: '/zone/chaumont-gistoux/' },
            { name: 'Court-Saint-Étienne', href: '/zone/court-saint-etienne/' },
          ].map(z => (
            <a href={z.href} class="text-sm text-[var(--color-vert)] font-medium hover:underline">{z.name}</a>
          ))}
        </div>
      </div>

      <!-- Services -->
      <div class="bg-white border border-[var(--color-bordure)] rounded-xl p-6">
        <h2 class="text-lg font-bold text-[var(--color-vert-fonce)] mb-3">Nos services</h2>
        <ul class="space-y-1">
          {[
            { label: 'Pompe à chaleur', href: '/pompe-a-chaleur/' },
            { label: 'Climatisation', href: '/climatisation/' },
            { label: 'Chauffage', href: '/chauffage/' },
            { label: 'Ventilation', href: '/ventilation/' },
            { label: 'Panneaux solaires', href: '/panneaux-solaires/' },
            { label: 'Sanitaire', href: '/sanitaire/' },
            { label: 'Électricité & domotique', href: '/electricite/' },
            { label: 'Bornes de recharge', href: '/bornes-de-recharge/' },
            { label: 'Boiler thermodynamique', href: '/boiler-thermodynamique/' },
          ].map(s => (
            <li><a href={s.href} class="text-sm text-[var(--color-vert)] font-medium hover:underline">{s.label}</a></li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Colonne droite : formulaire -->
    <div>
      <div class="bg-white border border-[var(--color-bordure)] rounded-xl p-6 sticky top-20">
        <h2 class="text-lg font-bold text-[var(--color-vert-fonce)] mb-4">Envoyez-nous un message</h2>
        <form action="#" method="POST" class="space-y-4">
          <div>
            <label for="nom" class="block text-sm font-semibold text-[var(--color-vert-fonce)] mb-1">Nom *</label>
            <input type="text" id="nom" name="nom" required
              class="w-full border border-[var(--color-bordure)] rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-vert)]" />
          </div>
          <div>
            <label for="email" class="block text-sm font-semibold text-[var(--color-vert-fonce)] mb-1">Email *</label>
            <input type="email" id="email" name="email" required
              class="w-full border border-[var(--color-bordure)] rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-vert)]" />
          </div>
          <div>
            <label for="tel" class="block text-sm font-semibold text-[var(--color-vert-fonce)] mb-1">Téléphone</label>
            <input type="tel" id="tel" name="tel"
              class="w-full border border-[var(--color-bordure)] rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-vert)]" />
          </div>
          <div>
            <label for="message" class="block text-sm font-semibold text-[var(--color-vert-fonce)] mb-1">Message *</label>
            <textarea id="message" name="message" rows="5" required placeholder="Décrivez votre projet ou votre question..."
              class="w-full border border-[var(--color-bordure)] rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-vert)] resize-y"></textarea>
          </div>
          <button type="submit"
            class="w-full bg-[var(--color-orange)] text-white font-bold text-base py-3.5 rounded-xl shadow-lg shadow-orange-200 hover:shadow-xl transition-all">
            Envoyer
          </button>
          <p class="text-xs text-[var(--color-texte-light)] text-center">
            Réponse sous 24h. Vos données ne servent qu'à vous répondre.
          </p>
        </form>
      </div>
    </div>

  </div>
</div>

<div class="h-20 lg:hidden"></div>

</Layout>
