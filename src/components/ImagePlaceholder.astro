---
interface Props {
  src: string
  alt: string
  width: number
  height: number
  class?: string
  loading?: 'lazy' | 'eager'
}

const { src, alt, width, height, class: className = '', loading = 'lazy' } = Astro.props
const exists = await Astro.glob('/public/images/**/*').then(() => true).catch(() => false)
---

<div class:list={['overflow-hidden rounded-xl', className]}>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    class="w-full h-full object-cover"
    onerror={`this.style.display='none';this.nextElementSibling.style.display='flex'`}
  />
  <div
    class="bg-[var(--color-vert-clair)] flex items-center justify-center text-[var(--color-vert)] text-sm font-medium"
    style={`display:none;aspect-ratio:${width}/${height}`}
  >
    {alt}
  </div>
</div>
