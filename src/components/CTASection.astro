---
interface Props {
  title?: string
  text?: string
}
const { title = "Un projet ? On en discute.", text = "Devis gratuit et sans engagement. Réponse sous 24h." } = Astro.props
---

<section class="mx-4 sm:mx-6 my-14">
  <div class="max-w-5xl mx-auto bg-gradient-to-br from-[var(--color-vert)] to-emerald-700 rounded-2xl p-8 sm:p-12 flex flex-col sm:flex-row items-center justify-between gap-6">
    <div class="text-white">
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-2">{title}</h2>
      <p class="text-white/80">{text}</p>
    </div>
    <a
      href="/devis/"
      class="bg-[var(--color-orange)] text-white font-bold text-base px-8 py-4 rounded-xl shadow-lg hover:shadow-xl transition-all whitespace-nowrap"
    >
      Demander un devis &rarr;
    </a>
  </div>
</section>
