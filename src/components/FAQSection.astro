---
interface FAQItem {
  question: string
  answer: string
}

interface Props {
  items: FAQItem[]
}

const { items } = Astro.props
---

<section class="py-14 px-4 sm:px-6 bg-white">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-2xl font-extrabold text-[var(--color-vert-fonce)] mb-8">
      Questions fréquentes
    </h2>
    <div class="space-y-4">
      {items.map(faq => (
        <details class="group border border-[var(--color-bordure)] rounded-xl" open>
          <summary class="flex items-center justify-between cursor-pointer px-6 py-4 font-semibold text-[var(--color-vert-fonce)]">
            {faq.question}
            <span class="text-[var(--color-vert)] group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-5 text-[var(--color-texte-light)] leading-relaxed">
            <p set:html={faq.answer} />
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer.replace(/<[^>]*>/g, '')
    }
  }))
})} />
