---
import { VAT_NUMBER } from '../data/business'

const services = [
  { href: '/pompe-a-chaleur/', label: 'Pompe à chaleur' },
  { href: '/climatisation/', label: 'Climatisation' },
  { href: '/chauffage/', label: 'Chauffage' },
  { href: '/ventilation/', label: 'Ventilation' },
  { href: '/sanitaire/', label: 'Sanitaire' },
  { href: '/panneaux-solaires/', label: 'Panneaux solaires' },
  { href: '/boiler-thermodynamique/', label: 'Boiler thermodynamique' },
  { href: '/bornes-de-recharge/', label: 'Bornes de recharge' },
  { href: '/electricite/', label: 'Électricité' },
  { href: '/domotique/', label: 'Domotique' },
]

const zones = [
  { href: '/wavre/', label: 'Wavre' },
  { href: '/waterloo/', label: 'Waterloo' },
  { href: '/lasne/', label: 'Lasne' },
  { href: '/braine-l-alleud/', label: "Braine-l'Alleud" },
  { href: '/rixensart/', label: 'Rixensart' },
  { href: '/la-hulpe/', label: 'La Hulpe' },
  { href: '/ottignies-louvain-la-neuve/', label: 'Ottignies-LLN' },
  { href: '/grez-doiceau/', label: 'Grez-Doiceau' },
  { href: '/chaumont-gistoux/', label: 'Chaumont-Gistoux' },
  { href: '/court-saint-etienne/', label: 'Court-Saint-Étienne' },
  { href: '/ittre/', label: 'Ittre' },
  { href: '/rhode-saint-genese/', label: 'Rhode-Saint-Genèse' },
  { href: '/nivelles/', label: 'Nivelles' },
  { href: '/genappe/', label: 'Genappe' },
  { href: '/overijse/', label: 'Overijse' },
]
---

<footer class="bg-[var(--color-vert-fonce)] text-[var(--color-fond)]">
  <div class="max-w-[88rem] mx-auto px-4 sm:px-8 pt-20 pb-10">

    <!-- Marque XL en haut -->
    <div class="border-b border-[var(--color-fond)]/15 pb-10 mb-10 flex flex-wrap items-end justify-between gap-8">
      <div>
        <p class="text-xs uppercase tracking-widest opacity-60 mb-3">Colophon</p>
        <p class="font-display font-semibold" style="font-size: clamp(2.5rem, 6vw, 5rem); line-height: 0.95; letter-spacing: -0.03em;">
          Pompe à chaleur <span style="font-variation-settings: 'wdth' 75; font-weight: 500;">BW</span>
        </p>
      </div>
      <a
        href="/devis/"
        class="group inline-flex items-center gap-4 bg-[var(--color-orange)] text-[var(--color-vert-fonce)] font-semibold px-7 py-4 hover:bg-[var(--color-fond)] transition-colors"
      >
        <span>Demander un devis</span>
        <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-10">

      <!-- Colonne 1 : Contact -->
      <div class="col-span-2 md:col-span-1">
        <p class="text-xs uppercase tracking-widest opacity-60 mb-4">Contact</p>
        <address class="not-italic text-sm leading-relaxed opacity-80 mb-3">
          Rue de Nivelles 77<br/>1300 Wavre<br/>Brabant Wallon
        </address>
        <p class="font-display text-xl font-semibold tabular-nums mb-1" style="letter-spacing: -0.015em;"><a href="tel:+3228861457" class="hover:text-[var(--color-orange)] transition-colors">02 / 886 14 57</a></p>
        <p class="text-sm opacity-80 mb-1"><a href="mailto:contact@pompe-a-chaleur-bw.be" class="hover:text-[var(--color-orange)] transition-colors">contact@pompe-a-chaleur-bw.be</a></p>
        <p class="text-xs opacity-60 tabular-nums">Lun–Dim · 8h–20h</p>
        {VAT_NUMBER && <p class="text-xs opacity-60 tabular-nums mt-2">N° d'entreprise : {VAT_NUMBER}</p>}
      </div>

      <!-- Colonne 2 : Services -->
      <div>
        <p class="text-xs uppercase tracking-widest opacity-60 mb-4">Services</p>
        <ul class="space-y-2.5">
          {services.map(s => (
            <li><a href={s.href} class="text-sm opacity-80 hover:opacity-100 hover:text-[var(--color-orange)] transition-colors">{s.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Colonne 3 : Zones -->
      <div>
        <p class="text-xs uppercase tracking-widest opacity-60 mb-4">Zones</p>
        <ul class="space-y-2.5">
          {zones.map(z => (
            <li><a href={z.href} class="text-sm opacity-80 hover:opacity-100 hover:text-[var(--color-orange)] transition-colors">{z.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Colonne 4 : Marques -->
      <div>
        <p class="text-xs uppercase tracking-widest opacity-60 mb-4">Marques</p>
        <ul class="grid grid-cols-2 gap-x-3 gap-y-2">
          {['Daikin', 'LG', 'Gree', 'Vaillant', 'Bemco', 'Bosch', 'Remeha', 'Atlantic', 'Ariston', 'Niko', 'Domintell', 'Panasonic'].map(m => (
            <li class="text-sm opacity-80 tabular-nums">{m}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-14 pt-6 border-t border-[var(--color-fond)]/15 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 text-xs opacity-50">
      <p class="tabular-nums">pompe-a-chaleur-bw.be &copy; {new Date().getFullYear()} · Brabant Wallon, Belgique</p>
      <div class="flex gap-6">
        <a href="/tarifs/" class="hover:opacity-80">Tarifs</a>
        <a href="/a-propos/" class="hover:opacity-80">À propos</a>
        <a href="/contact/" class="hover:opacity-80">Contact</a>
        <a href="/mentions-legales/" class="hover:opacity-80">Mentions légales</a>
        <a href="/politique-cookies/" class="hover:opacity-80">Cookies</a>
      </div>
    </div>
  </div>
</footer>
