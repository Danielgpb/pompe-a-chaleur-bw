---
const reviews = [
  {
    initials: 'CG',
    name: 'Cindy Garnier',
    text: "Beau boulot, j'ai rien à dire !",
  },
  {
    initials: 'MG',
    name: 'Martin Garcia Navio',
    text: "Installation de notre pompe à chaleur à Wavre impeccable, devis clair, prime Brabant Wallon expliquée et belle économie sur les factures. Je recommande.",
  },
  {
    initials: 'CM',
    name: 'Carlos Melin',
    text: "Je recommande vivement ! Super pro, ils m'ont installé ma climatisation super proprement !",
  },
  {
    initials: 'AP',
    name: 'Ariel Perez',
    text: 'Super sérieux, efficace pour le placement de ma pompe à chaleur.',
  },
  {
    initials: 'JR',
    name: 'Jen R',
    text: 'Ils ont placé ma pompe à chaleur super pro et disponible. Merci.',
  },
  {
    initials: 'JD',
    name: 'Jérôme Deleu',
    text: 'Ils ont installé ma climatisation super professionnel, réactif !',
  },
  {
    initials: 'TD',
    name: 'Tanguy Dimanche',
    text: 'Service réactif et rapide, ils ont réparé ma climatisation rapidement.',
  },
  {
    initials: 'AD',
    name: 'Annis Dimah',
    text: 'Service pro ! Ils savent de quoi ils parlent.',
  },
  {
    initials: 'IS',
    name: 'IML siuu',
    text: 'Intervention très rapide de leur part, tout est correct rapide et efficace.',
  },
]
---

<section class="py-10 px-4 sm:px-8 bg-[var(--color-fond)]">
  <div class="max-w-[88rem] mx-auto">
    <div class="flex items-center gap-4 mb-6">
      <span class="section-number">§ 03 — Avis Google</span>
      <span class="h-px flex-1 bg-[var(--color-bordure)]"></span>
      <span class="text-xs text-[var(--color-texte-light)] uppercase tracking-wider tabular-nums">5,0 / 5 · 9 avis</span>
    </div>
    <div class="reviews-carousel-wrapper">
      <div class="reviews-carousel-track">
        {[...Array(2)].map(() => (
          <div class="reviews-carousel-set">
            {reviews.map(r => (
              <figure class="bg-[var(--color-blanc)] border border-[var(--color-bordure)] p-6 min-w-[320px] max-w-[360px] flex-shrink-0">
                <div class="flex items-center gap-1.5 mb-4 text-[var(--color-orange)] text-xs tracking-widest">★★★★★</div>
                <blockquote class="font-display text-[var(--color-vert-fonce)] leading-snug mb-5" style="font-size: 1.125rem; letter-spacing: -0.01em; font-weight: 500;">
                  « {r.text} »
                </blockquote>
                <figcaption class="flex items-baseline justify-between gap-3 pt-4 border-t border-[var(--color-bordure)]">
                  <span class="text-sm font-semibold text-[var(--color-vert-fonce)]">{r.name}</span>
                  <span class="text-xs text-[var(--color-texte-light)] uppercase tracking-wider">Avis Google</span>
                </figcaption>
              </figure>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .reviews-carousel-wrapper {
    overflow: hidden;
    width: 100%;
  }
  .reviews-carousel-track {
    display: flex;
    width: max-content;
    animation: reviews-scroll 30s linear infinite;
  }
  .reviews-carousel-set {
    display: flex;
    gap: 1.25rem;
    flex-shrink: 0;
    padding-right: 1.25rem;
  }
  @keyframes reviews-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .reviews-carousel-wrapper:hover .reviews-carousel-track {
    animation-play-state: paused;
  }
</style>
