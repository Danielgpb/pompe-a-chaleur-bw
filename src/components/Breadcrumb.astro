---
interface Props {
  items: { label: string; href?: string }[]
}
const { items } = Astro.props
---

<nav aria-label="Fil d'Ariane" class="max-w-7xl mx-auto px-4 sm:px-6 py-4">
  <ol class="flex flex-wrap items-center gap-1 text-sm text-[var(--color-texte-light)]">
    <li>
      <a href="/" class="hover:text-[var(--color-vert)] transition-colors">Accueil</a>
    </li>
    {items.map((item, i) => (
      <li class="flex items-center gap-1">
        <span class="opacity-40">/</span>
        {item.href && i < items.length - 1 ? (
          <a href={item.href} class="hover:text-[var(--color-vert)] transition-colors">{item.label}</a>
        ) : (
          <span class="font-medium text-[var(--color-vert-fonce)]">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://pompe-a-chaleur-bw.be/" },
    ...items.map((item, i) => ({
      "@type": "ListItem",
      "position": i + 2,
      "name": item.label,
      ...(item.href ? { "item": `https://pompe-a-chaleur-bw.be${item.href}` } : {})
    }))
  ]
})} />
