---
const navLinks = [
  { href: '/pompe-a-chaleur/', label: 'Pompe à chaleur' },
  { href: '/climatisation/', label: 'Climatisation' },
  { href: '/chauffage/', label: 'Chauffage' },
  { href: '/panneaux-solaires/', label: 'Solaire' },
  { href: '/electricite/', label: 'Électricité' },
]

const currentPath = Astro.url.pathname
---

<header class="bg-white border-b border-[var(--color-bordure)] sticky top-0 z-50">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-16 lg:h-18">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-1 shrink-0">
      <span class="text-xl font-extrabold text-[var(--color-vert)]">PAC</span>
      <span class="text-xl font-light text-[var(--color-texte-light)]">-BW</span>
      <span class="text-xs text-[var(--color-texte-light)] ml-1 hidden sm:inline">.be</span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden lg:flex items-center gap-6">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class:list={[
              'text-sm font-medium transition-colors',
              currentPath.startsWith(link.href)
                ? 'text-[var(--color-vert)] font-semibold'
                : 'text-[var(--color-texte-light)] hover:text-[var(--color-vert)]'
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a href="/zone/" class="text-sm font-medium text-[var(--color-texte-light)] hover:text-[var(--color-vert)]">
          Nos zones
        </a>
      </li>
    </ul>

    <!-- CTA desktop -->
    <div class="hidden lg:flex items-center gap-4">
      <a href="tel:+3228861457" class="text-sm font-bold text-[var(--color-vert)]">
        02 / 886 14 57
      </a>
      <a
        href="/devis/"
        class="bg-[var(--color-vert)] text-white text-sm font-bold px-5 py-2.5 rounded-lg hover:bg-[var(--color-vert-fonce)] transition-colors"
      >
        Devis gratuit
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden p-2 rounded-lg hover:bg-gray-100"
      aria-label="Ouvrir le menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-[var(--color-bordure)]">
    <div class="px-4 py-4 space-y-3">
      {navLinks.map(link => (
        <a href={link.href} class="block text-base font-medium text-[var(--color-texte)] py-2">
          {link.label}
        </a>
      ))}
      <a href="/ventilation/" class="block text-base font-medium text-[var(--color-texte)] py-2">Ventilation</a>
      <a href="/sanitaire/" class="block text-base font-medium text-[var(--color-texte)] py-2">Sanitaire</a>
      <a href="/zone/" class="block text-base font-medium text-[var(--color-texte)] py-2">Nos zones</a>
      <hr class="border-[var(--color-bordure)]" />
      <a href="/devis/" class="block bg-[var(--color-vert)] text-white text-center font-bold py-3 rounded-lg">
        Devis gratuit
      </a>
      <a href="tel:+3228861457" class="block text-center font-bold text-[var(--color-vert)] py-2">
        02 / 886 14 57
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn')
  const menu = document.getElementById('mobile-menu')
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden')
  })
</script>
