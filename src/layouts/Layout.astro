---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import StickyMobileCTA from '../components/StickyMobileCTA.astro'

interface Props {
  title: string
  description: string
  canonical?: string
}

const { title, description, canonical } = Astro.props
const siteUrl = 'https://pompe-a-chaleur-bw.be'
const fullCanonical = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${Astro.url.pathname}`
---

<!DOCTYPE html>
<html lang="fr-BE">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={fullCanonical} />
  <meta name="robots" content="index, follow" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_BE" />
  <meta property="og:url" content={fullCanonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Schema.org LocalBusiness -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "HVACBusiness",
    "name": "Pompe à chaleur BW — Brabant Wallon",
    "url": siteUrl,
    "telephone": "+32-2-886-14-57",
    "description": "Installation pompe à chaleur, climatisation, chauffage et panneaux solaires en Brabant Wallon. Wavre, Waterloo, Lasne et 10 communes.",
    "areaServed": [
      { "@type": "City", "name": "Wavre" },
      { "@type": "City", "name": "Waterloo" },
      { "@type": "City", "name": "Lasne" },
      { "@type": "City", "name": "Braine-l'Alleud" },
      { "@type": "City", "name": "Rixensart" },
      { "@type": "City", "name": "La Hulpe" },
      { "@type": "City", "name": "Ottignies-Louvain-la-Neuve" },
      { "@type": "City", "name": "Grez-Doiceau" },
      { "@type": "City", "name": "Chaumont-Gistoux" },
      { "@type": "City", "name": "Court-Saint-Étienne" }
    ],
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Wavre",
      "addressRegion": "Brabant Wallon",
      "addressCountry": "BE"
    },
    "priceRange": "€€",
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "08:00",
      "closes": "18:00"
    }
  })} />
</head>
<body class="min-h-screen flex flex-col">
  <Nav />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
  <StickyMobileCTA />
</body>
</html>
