---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import StickyMobileCTA from '../components/StickyMobileCTA.astro'
import WhatsAppBubble from '../components/WhatsAppBubble.astro'

interface Props {
  title: string
  description: string
  canonical?: string
  geoLat?: number
  geoLng?: number
  geoPlacename?: string
}

const { title, description, canonical, geoLat, geoLng, geoPlacename } = Astro.props
const siteUrl = 'https://pompe-a-chaleur-bw.be'
const fullCanonical = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${Astro.url.pathname}`
---

<!DOCTYPE html>
<html lang="fr-BE">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={fullCanonical} />
  <meta name="robots" content="index, follow" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_BE" />
  <meta property="og:url" content={fullCanonical} />
  <meta property="og:image" content={`${siteUrl}/images/global/og-image.webp`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}/images/global/og-image.webp`} />
  {geoLat && geoLng && (
    <>
      <meta name="geo.position" content={`${geoLat};${geoLng}`} />
      <meta name="ICBM" content={`${geoLat}, ${geoLng}`} />
      <meta name="geo.region" content="BE-WBR" />
      {geoPlacename && <meta name="geo.placename" content={geoPlacename} />}
    </>
  )}
  <link rel="preconnect" href="https://fonts.googleapis.com" />

  <!-- Schema.org WebSite — identifie le site pour Google -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Pompe à chaleur BW",
    "url": siteUrl,
    "description": "Chauffage, pompe à chaleur et climatisation en Brabant Wallon. Installateur agréé.",
    "inLanguage": "fr-BE",
    "publisher": {
      "@type": "Organization",
      "name": "Pompe à chaleur BW",
      "url": siteUrl,
      "telephone": "+32-2-886-14-57"
    }
  })} />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Schema.org HVACBusiness — enrichi pour AI citation -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "HVACBusiness",
    "@id": `${siteUrl}/#business`,
    "name": "Pompe à chaleur BW",
    "alternateName": "Pompe à chaleur Brabant Wallon",
    "url": siteUrl,
    "telephone": "+32-2-886-14-57",
    "image": `${siteUrl}/images/global/og-image.webp`,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/favicon-192.png`,
      "width": 192,
      "height": 192
    },
    "description": "Pompe à chaleur BW est l'installateur de chauffage, pompes à chaleur et climatisation de référence en Brabant Wallon. Installation, entretien et dépannage à Wavre, Waterloo, Lasne et 10 communes. Daikin, LG, Vaillant, Bosch, Gree.",
    "slogan": "Chauffage et pompe à chaleur en Brabant Wallon — installateur agréé",
    "additionalType": "https://schema.org/HeatingContractor",
    "foundingDate": "2024",
    "numberOfEmployees": {
      "@type": "QuantitativeValue",
      "minValue": 2,
      "maxValue": 10
    },
    "knowsAbout": [
      "Installation pompe à chaleur air-eau",
      "Installation pompe à chaleur air-air",
      "Pompe à chaleur hybride",
      "Remplacement chaudière mazout par pompe à chaleur",
      "Installation climatisation mono-split",
      "Installation climatisation multi-split",
      "Climatisation réversible",
      "Climatisation gainable",
      "Installation chaudière gaz condensation",
      "Chauffage sol plancher chauffant",
      "Entretien chaudière gaz obligatoire",
      "Installation VMC double flux",
      "Installation VMC simple flux",
      "Rénovation salle de bain",
      "Installation adoucisseur eau",
      "Installation panneaux solaires photovoltaïques",
      "Installation batterie domestique",
      "Installation borne de recharge véhicule électrique",
      "Installation domotique Niko Home Control",
      "Installation boiler thermodynamique",
      "Mise en conformité électrique RGIE",
      "Dépannage pompe à chaleur",
      "Dépannage climatisation",
      "Dépannage chaudière",
      "Primes pompe à chaleur Wallonie"
    ],
    "areaServed": [
      { "@type": "City", "name": "Wavre", "postalCode": "1300" },
      { "@type": "City", "name": "Waterloo", "postalCode": "1410" },
      { "@type": "City", "name": "Lasne", "postalCode": "1380" },
      { "@type": "City", "name": "Braine-l'Alleud", "postalCode": "1420" },
      { "@type": "City", "name": "Rixensart", "postalCode": "1330" },
      { "@type": "City", "name": "La Hulpe", "postalCode": "1310" },
      { "@type": "City", "name": "Ottignies-Louvain-la-Neuve", "postalCode": "1340" },
      { "@type": "City", "name": "Grez-Doiceau", "postalCode": "1390" },
      { "@type": "City", "name": "Chaumont-Gistoux", "postalCode": "1325" },
      { "@type": "City", "name": "Court-Saint-Étienne", "postalCode": "1490" }
    ],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Rue de Nivelles 77",
      "addressLocality": "Wavre",
      "postalCode": "1300",
      "addressRegion": "Brabant Wallon",
      "addressCountry": "BE"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 50.71640,
      "longitude": 4.60130
    },
    "sameAs": [
      "https://www.google.com/maps/place/Pompe+%C3%A0+chaleur+BW/@50.7143234,4.6064332,17z/"
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5.0",
      "reviewCount": "5",
      "bestRating": "5",
      "worstRating": "1"
    },
    "priceRange": "€€",
    "paymentAccepted": "Cash, Virement bancaire, Bancontact",
    "currenciesAccepted": "EUR",
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
        "opens": "08:00",
        "closes": "20:00"
      }
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Services Pompe à chaleur BW",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Installation pompe à chaleur", "url": `${siteUrl}/pompe-a-chaleur/` } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Installation climatisation", "url": `${siteUrl}/climatisation/` } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Chauffage", "url": `${siteUrl}/chauffage/` } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ventilation VMC", "url": `${siteUrl}/ventilation/` } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Panneaux solaires", "url": `${siteUrl}/panneaux-solaires/` } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Sanitaire et plomberie", "url": `${siteUrl}/sanitaire/` } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Électricité et domotique", "url": `${siteUrl}/electricite/` } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Borne de recharge", "url": `${siteUrl}/bornes-de-recharge/` } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Boiler thermodynamique", "url": `${siteUrl}/boiler-thermodynamique/` } }
      ]
    }
  })} />
</head>
<body class="min-h-screen flex flex-col">
  <Nav />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
  <WhatsAppBubble />
  <StickyMobileCTA />
</body>
</html>
